# ---- Temporal (local dev server: `temporal server start-dev`) ----
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=temporal-pipeline

# ---- MongoDB Atlas (REQUIRED) ----
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=temporal
CHUNKS_COLLECTION=chunks_staging
# Zero-copy searchable collection: pointers and vectors, never text.
KNOWLEDGE_COLLECTION=knowledge_zc
KNOWLEDGE_V2_COLLECTION=knowledge_v2
CONFIG_COLLECTION=temporal_config
MEMORY_COLLECTION=agent_memory

# ---- Voyage AI (REQUIRED) ----
VOYAGE_API_KEY=<your-voyage-api-key>
# Use a model your key is authorized for (voyage-3 is deprecated; voyage-3.5 is current).
VOYAGE_MODEL=voyage-3.5
# MongoDB's hosted Voyage endpoint. Leave as-is; api.voyageai.com is not in
# agent.yaml's egress allow-list. The key issued for this endpoint starts "al-".
VOYAGE_BASE_URL=https://ai.mongodb.com/v1
EMBED_DIM=1024

# ---- S3 source ----
# The worker indexes this bucket's objects and the agent's read_span
# tool reads them back, so both must see the same bucket. temporal-agentic
# (us-east-1) is the one agent.yaml's egress allow-list names; a different bucket
# or region needs that list changed too.
AWS_REGION=us-east-1
S3_BUCKET=temporal-agentic
# Leave both blank to use boto3's standard credential chain (profile / role).
AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>

# ---- Chunking ----
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# ---- Atlas Agent Engine agent (mongodb_agent_engine/) ----
# One generic key name whatever the provider.
LLM_API_KEY=<your-llm-api-key>
# anthropic (default) | openai | gemini
# agent.yaml's egress allow-list names api.anthropic.com only. Switching
# provider means adding that provider's host to the list first.
LLM_PROVIDER=anthropic
# Optional: route anthropic or openai through a compatible gateway. Its host
# also has to be added to agent.yaml's egress list before a hosted deploy.
# LLM_BASE_URL=
# Optional: header that carries LLM_API_KEY, for gateways that do not read the
# provider's usual auth header (for example api-key).
# LLM_API_KEY_HEADER=
# Optional override of the per-provider default model.
# LLM_MODEL=claude-sonnet-5
